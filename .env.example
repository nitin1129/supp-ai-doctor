SUPPAI_ENV=dev
# Standalone mongod, a replica set or Atlas (mongodb+srv://...) all work.
SUPPAI_MONGO_URL=mongodb://localhost:27017
SUPPAI_MONGO_DB=suppai

# Shared with the main SuppAI auth service, which signs admin and member tokens.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPPAI_JWT_SECRET=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUPPAI_DATA_ENCRYPTION_KEY=

SUPPAI_PUBLIC_SITE_URL=https://suppai.in
SUPPAI_STORAGE_DIR=./storage/private

# Razorpay (set PAYMENTS_PROVIDER=razorpay in production)
SUPPAI_PAYMENTS_PROVIDER=fake
SUPPAI_RAZORPAY_KEY_ID=
SUPPAI_RAZORPAY_KEY_SECRET=
SUPPAI_RAZORPAY_WEBHOOK_SECRET=

# Business rules
SUPPAI_COMMISSION_PERCENT=15
SUPPAI_SLOT_HOLD_MINUTES=5
SUPPAI_RESCHEDULE_CUTOFF_HOURS=4
SUPPAI_CANCEL_FULL_REFUND_CUTOFF_HOURS=4
SUPPAI_PATIENT_NO_SHOW_REFUND_PERCENT=0
