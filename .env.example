SUPPAI_ENV=dev
# Standalone mongod, a replica set or Atlas (mongodb+srv://...) all work.
SUPPAI_MONGO_URL=mongodb://localhost:27017
SUPPAI_MONGO_DB=suppai

# Shared with the main SuppAI auth service, which signs admin and member tokens.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
