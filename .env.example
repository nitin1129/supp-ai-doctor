# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUPPAI_DATA_ENCRYPTION_KEY=6ITL2hXFmXtR6tlOs-vRrTYlrScY7QebdK9XPnfa5D8=

SUPPAI_PUBLIC_SITE_URL=https://suppai.in
SUPPAI_STORAGE_DIR=./storage/private

# Email — set to "brevo" in production
SUPPAI_EMAIL_PROVIDER=log
SUPPAI_BREVO_API_KEY=
SUPPAI_EMAIL_FROM=no-reply@suppai.in
SUPPAI_EMAIL_FROM_NAME=SuppAI

# OTP rules (defaults shown; override in .env if needed)
# SUPPAI_OTP_TTL_MINUTES=10
# SUPPAI_OTP_MAX_ATTEMPTS=5
# SUPPAI_OTP_RESEND_SECONDS=60
# SUPPAI_OTP_MAX_PER_EMAIL_HOUR=5
# SUPPAI_OTP_MAX_PER_IP_HOUR=20
# SUPPAI_OTP_MAX_VERIFY_PER_IP_15MIN=10
# SUPPAI_MEMBER_OTP_SIGNUP=true
# SUPPAI_MEMBERS_COLLECTION=users
# SUPPAI_MEMBER_EMAIL_FIELD=email
# SUPPAI_MEMBER_NAME_FIELD=name

# Razorpay (set PAYMENTS_PROVIDER=razorpay in production)
